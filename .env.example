# Public Sanity project settings
NEXT_PUBLIC_SANITY_PROJECT_ID=qp5316nb
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional server-side read-only Sanity token. Never use NEXT_PUBLIC_ for this token.
SANITY_API_READ_TOKEN=your-sanity-read-only-token

# Stripe: publishable key is public; secret key must remain server-only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace-me
STRIPE_SECRET_KEY=sk_test_replace-me

# Checkout configuration. Use a Stripe shipping rate created in test mode locally.
SITE_URL=http://localhost:3000
STRIPE_SHIPPING_RATE_ID=shr_replace-me
STRIPE_ALLOWED_SHIPPING_COUNTRIES=US,CA
